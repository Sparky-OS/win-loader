default		0
color		cyan/blue white/blue
find		--set-root /debian/initrd.gz

title		Standard
kernel		/debian/linux vga=normal --
initrd		/debian/initrd.gz

title		Expert
kernel		/debian/linux priority=low vga=normal --
initrd		/debian/initrd.gz

title		Auto
kernel		/debian/linux priority=critical vga=normal --
initrd		/debian/initrd.gz
